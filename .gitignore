__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
experiments/logs/*.json
experiments/logs/*.out
experiments/status/*.json
experiments/reports/*.md
experiments/reviews/*.md
experiments/leaderboard.json
experiments/mistakes.json
experiments/token_budget.json
experiments/context/session.md
configs/token_budget.yaml
!experiments/logs/.gitkeep
!experiments/status/.gitkeep
!experiments/reports/.gitkeep
!experiments/reviews/.gitkeep
!experiments/context/.gitkeep

# Project-specific capsules, ideas, and contracts — track only templates/examples.
configs/project_capsules/*
!configs/project_capsules/example.yaml
configs/machines/*
!configs/machines/example_machine.yaml
ideas/*
!ideas/TEMPLATE.md
!ideas/example_idea.md
experiments/contracts/*
!experiments/contracts/example_run.yaml

